<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calculator_background"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Oasis Calculator logo"
            android:src="@drawable/app_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="OASIS"
                android:textColor="@color/title_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="CALCULATOR"
                android:textColor="@color/subtitle_text"
                android:textSize="10sp"
                android:letterSpacing="0.16" />
        </LinearLayout>

        <Button
            android:id="@+id/historyButton"
            style="@style/CalculatorUtilityButton"
            android:layout_width="48dp"
            android:layout_height="46dp"
            android:contentDescription="Calculation history"
            android:text="◷"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1.2"
        android:background="@drawable/display_card_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUR CALCULATION"
                android:textColor="#9297A9"
                android:textSize="10sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/memoryIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/memory_bg"
                android:paddingStart="9dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:text="M"
                android:textColor="@color/memory_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/expressionDisplay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="bottom|end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="3dp"
            android:text=""
            android:textColor="@color/display_secondary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/resultDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end|center_vertical"
            android:longClickable="true"
            android:maxLines="1"
            android:minHeight="68dp"
            android:paddingBottom="5dp"
            android:text="0"
            android:textColor="@color/display_text"
            android:textSize="48sp"
            android:textStyle="bold"
            android:contentDescription="Calculator result; long press to copy" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Long press result to copy"
            android:textColor="@color/hint_text"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button style="@style/CalculatorMemoryButton" android:text="MC" android:contentDescription="Clear memory" />
        <Button style="@style/CalculatorMemoryButton" android:text="MR" android:contentDescription="Recall memory" />
        <Button style="@style/CalculatorMemoryButton" android:text="M+" android:contentDescription="Add to memory" />
        <Button style="@style/CalculatorMemoryButton" android:text="M−" android:contentDescription="Subtract from memory" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.65"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <Button style="@style/CalculatorUtilityButton" android:text="C" android:contentDescription="Clear" />
        <Button style="@style/CalculatorUtilityButton" android:text="DEL" android:contentDescription="Backspace" android:textSize="15sp" />
        <Button style="@style/CalculatorUtilityButton" android:text="√x" android:contentDescription="Square root" android:textSize="17sp" />
        <Button style="@style/CalculatorOperatorButton" android:text="÷" android:contentDescription="Divide" />

        <Button style="@style/CalculatorNumberButton" android:text="7" />
        <Button style="@style/CalculatorNumberButton" android:text="8" />
        <Button style="@style/CalculatorNumberButton" android:text="9" />
        <Button style="@style/CalculatorOperatorButton" android:text="×" android:contentDescription="Multiply" />

        <Button style="@style/CalculatorNumberButton" android:text="4" />
        <Button style="@style/CalculatorNumberButton" android:text="5" />
        <Button style="@style/CalculatorNumberButton" android:text="6" />
        <Button style="@style/CalculatorOperatorButton" android:text="−" android:contentDescription="Subtract" />

        <Button style="@style/CalculatorNumberButton" android:text="1" />
        <Button style="@style/CalculatorNumberButton" android:text="2" />
        <Button style="@style/CalculatorNumberButton" android:text="3" />
        <Button style="@style/CalculatorOperatorButton" android:text="+" android:contentDescription="Add" />

        <Button style="@style/CalculatorUtilityButton" android:text="±" android:contentDescription="Toggle sign" />
        <Button style="@style/CalculatorNumberButton" android:text="0" />
        <Button style="@style/CalculatorUtilityButton" android:text="%" android:contentDescription="Percent" />
        <Button style="@style/CalculatorEqualsButton" android:text="=" android:contentDescription="Equals" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button style="@style/CalculatorQuickFunctionButton" android:text="x²" android:contentDescription="Square current number" />
        <Button style="@style/CalculatorQuickFunctionButton" android:text="Copy" android:contentDescription="Copy result" />
    </LinearLayout>
</LinearLayout>
