<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calculator_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Oasis Calculator logo"
            android:src="@drawable/app_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Oasis Calculator"
            android:textColor="@color/title_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/memoryIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@color/memory_bg"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="M"
            android:textColor="@color/memory_text"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/historyButton"
            style="@style/CalculatorHeaderButton"
            android:contentDescription="Calculation history"
            android:text="◴"
            android:textSize="20sp" />

        <Button
            android:id="@+id/themeButton"
            style="@style/CalculatorHeaderButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Switch to dark theme"
            android:text="☾"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1.2"
        android:background="@drawable/display_card_background"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/memory_bg"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="DEG"
            android:textColor="@color/memory_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/expressionDisplay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="bottom|end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:paddingTop="12dp"
            android:paddingBottom="5dp"
            android:text=""
            android:textColor="@color/display_text"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/resultDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="end|center_vertical"
            android:longClickable="true"
            android:maxLines="1"
            android:minHeight="42dp"
            android:paddingBottom="5dp"
            android:text="0"
            android:textColor="@color/display_secondary"
            android:textSize="21sp"
            android:contentDescription="Calculator result; long press to copy" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/display_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/scientificToggle"
                style="@style/CalculatorScientificToggle"
                android:text="⌄  Scientific"
                android:contentDescription="Show scientific calculator functions" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                style="@style/CalculatorHeaderButton"
                android:contentDescription="Delete last character"
                android:text="⌫"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scientificPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <Button style="@style/CalculatorScientificButton" android:text="sin" android:contentDescription="Sine in degrees" />
            <Button style="@style/CalculatorScientificButton" android:text="cos" android:contentDescription="Cosine in degrees" />
            <Button style="@style/CalculatorScientificButton" android:text="tan" android:contentDescription="Tangent in degrees" />
            <Button style="@style/CalculatorScientificButton" android:text="√x" android:contentDescription="Square root" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <Button style="@style/CalculatorScientificButton" android:text="x²" android:contentDescription="Square current number" />
            <Button style="@style/CalculatorScientificButton" android:text="ln" android:contentDescription="Natural logarithm" />
            <Button style="@style/CalculatorScientificButton" android:text="log" android:contentDescription="Logarithm base ten" />
            <Button style="@style/CalculatorScientificButton" android:text="Copy" android:contentDescription="Copy result" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button style="@style/CalculatorMemoryButton" android:text="MC" android:contentDescription="Clear memory" />
            <Button style="@style/CalculatorMemoryButton" android:text="MR" android:contentDescription="Recall memory" />
            <Button style="@style/CalculatorMemoryButton" android:text="M+" android:contentDescription="Add to memory" />
            <Button style="@style/CalculatorMemoryButton" android:text="M−" android:contentDescription="Subtract from memory" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.8"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <Button style="@style/CalculatorClearButton" android:text="AC" android:contentDescription="All clear" />
        <Button style="@style/CalculatorUtilityButton" android:text="()" android:contentDescription="Parentheses" />
        <Button style="@style/CalculatorUtilityButton" android:text="%" android:contentDescription="Percent" />
        <Button style="@style/CalculatorOperatorButton" android:text="÷" android:contentDescription="Divide" />

        <Button style="@style/CalculatorNumberButton" android:text="7" />
        <Button style="@style/CalculatorNumberButton" android:text="8" />
        <Button style="@style/CalculatorNumberButton" android:text="9" />
        <Button style="@style/CalculatorOperatorButton" android:text="×" android:contentDescription="Multiply" />

        <Button style="@style/CalculatorNumberButton" android:text="4" />
        <Button style="@style/CalculatorNumberButton" android:text="5" />
        <Button style="@style/CalculatorNumberButton" android:text="6" />
        <Button style="@style/CalculatorOperatorButton" android:text="−" android:contentDescription="Subtract" />

        <Button style="@style/CalculatorNumberButton" android:text="1" />
        <Button style="@style/CalculatorNumberButton" android:text="2" />
        <Button style="@style/CalculatorNumberButton" android:text="3" />
        <Button style="@style/CalculatorOperatorButton" android:text="+" android:contentDescription="Add" />

        <Button style="@style/CalculatorNumberButton" android:text="0" />
        <Button style="@style/CalculatorNumberButton" android:text="." android:contentDescription="Decimal point" />
        <Button style="@style/CalculatorUtilityButton" android:text="±" android:contentDescription="Toggle sign" />
        <Button style="@style/CalculatorEqualsButton" android:text="=" android:contentDescription="Equals" />
    </GridLayout>
</LinearLayout>
