<resources>
    <style name="CalculatorButtonBase" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="CalculatorNumberButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#252A40</item>
        <item name="android:backgroundTint">#FFFFFF</item>
    </style>

    <style name="CalculatorUtilityButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#525B78</item>
        <item name="android:backgroundTint">#E9EBF5</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalculatorOperatorButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#4C50C8</item>
        <item name="android:backgroundTint">#E7E8FF</item>
    </style>

    <style name="CalculatorEqualsButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#585BDE</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalculatorMemoryButton" parent="CalculatorButtonBase">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">#E7F5F0</item>
        <item name="android:textColor">#25866D</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalculatorQuickFunctionButton" parent="CalculatorButtonBase">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#6267C9</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
