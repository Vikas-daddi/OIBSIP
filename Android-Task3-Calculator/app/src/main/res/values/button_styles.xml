<resources>
    <style name="CalculatorButtonBase" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/key_circle_background</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="CalculatorNumberButton" parent="CalculatorButtonBase">
        <item name="android:textColor">@color/number_text</item>
        <item name="android:backgroundTint">@color/number_bg</item>
    </style>

    <style name="CalculatorUtilityButton" parent="CalculatorButtonBase">
        <item name="android:textColor">@color/utility_text</item>
        <item name="android:backgroundTint">@color/utility_bg</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalculatorClearButton" parent="CalculatorButtonBase">
        <item name="android:textColor">@color/clear_text</item>
        <item name="android:backgroundTint">@color/clear_bg</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="CalculatorOperatorButton" parent="CalculatorButtonBase">
        <item name="android:textColor">@color/operator_text</item>
        <item name="android:backgroundTint">@color/operator_bg</item>
    </style>

    <style name="CalculatorEqualsButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">@color/equals_bg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalculatorMemoryButton" parent="CalculatorButtonBase">
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/utility_bg</item>
        <item name="android:textColor">@color/utility_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalculatorQuickFunctionButton" parent="CalculatorButtonBase">
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/quick_bg</item>
        <item name="android:textColor">@color/quick_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalculatorHeaderButton" parent="CalculatorButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:backgroundTint">@color/header_action_bg</item>
        <item name="android:textColor">@color/header_action_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalculatorScientificToggle" parent="CalculatorButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:backgroundTint">@color/scientific_bg</item>
        <item name="android:textColor">@color/scientific_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="CalculatorScientificButton" parent="CalculatorButtonBase">
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/scientific_bg</item>
        <item name="android:textColor">@color/scientific_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
