<resources>
    <style name="CalculatorButtonBase" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="CalculatorNumberButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#202337</item>
        <item name="android:backgroundTint">#FFFFFF</item>
    </style>
    <style name="CalculatorUtilityButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#555B75</item>
        <item name="android:backgroundTint">#E8EAF2</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="CalculatorOperatorButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#4145B6</item>
        <item name="android:backgroundTint">#E4E5FF</item>
    </style>
    <style name="CalculatorEqualsButton" parent="CalculatorButtonBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#5B5CE2</item>
    </style>
</resources>
